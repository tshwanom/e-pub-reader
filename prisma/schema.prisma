// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      UserRole @default(READER)
  readerPreferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           Note[]
  donations       Donation[]
  audiobook       Audiobook?        @relation(fields: [audiobookId], references: [id])
  accounts        Account[]
  sessions        Session[]
  audiobookId     String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id          String     @id @default(cuid())
  title       String
  author      String
  description String     @db.Text
  coverUrl    String
  slug        String     @unique
  status      BookStatus @default(DRAFT)
  donorOnly   Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Monetization
  donationEnabled Boolean  @default(false)
  donationMessage String?  @db.Text
  donationGoal    Decimal? @db.Decimal(10, 2)
  amazonKdpUrl    String?

  // EPUB Metadata
  publisher String?
  language  String?  @default("en")
  isbn      String?
  coverIsbn String? // ISBN from cover image metadata
  subjects  String[] // Categories/tags from EPUB

  epubFile              BookFile?
  audioFiles            AudioFile[]
  printLinks            PrintLink[]
  categories            Category[]
  readingProgress       ReadingProgress[]
  bookmarks             Bookmark[]
  highlights            Highlight[]
  notes                 Note[]
  donations             Donation[]
  audiobook             Audiobook?
  narrations            BookNarration[]
  supplementaryContents SupplementaryContent[]
}

model BookFile {
  id        String   @id @default(cuid())
  bookId    String   @unique
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
}

model AudioFile {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  duration  Int? // seconds
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PrintLink {
  id        String      @id @default(cuid())
  bookId    String
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  provider  String // "Amazon KDP", "IngramSpark", "Lulu"
  format    PrintFormat // PAPERBACK, HARDCOVER
  url       String
  createdAt DateTime    @default(now())
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  books Book[]
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi       String // ePub CFI (Canonical Fragment Identifier)
  progress  Float // 0-100 percentage
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi       String
  chapter   String?
  createdAt DateTime @default(now())
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi       String
  text      String   @db.Text
  color     String   @default("#FFEB3B")
  note      String?  @db.Text
  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cfi       String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id        String         @id @default(cuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookId    String?
  book      Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  amount    Decimal        @db.Decimal(10, 2)
  currency  String         @default("USD")
  donorAmount Decimal?     @db.Decimal(10, 2)
  donorCurrency String?
  donorEmail String?
  gateway   DonationGateway @default(PAYPAL)
  gatewayAmount Decimal?   @db.Decimal(10, 2)
  gatewayCurrency String?
  paypalId  String?        @unique
  paystackReference String? @unique
  status    DonationStatus
  createdAt DateTime       @default(now())
}

enum UserRole {
  READER
  EDITOR
  ADMIN
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Audiobook {
  id        String   @id @default(cuid())
  bookId    String   @unique
  fileUrl   String
  duration  Int // Duration in seconds
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  users User[]
}

model NarrationVoice {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  provider    String
  language    String   @default("en")
  description String?  @db.Text
  sampleText  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  narrations BookNarration[]
}

model BookNarration {
  id               String                   @id @default(cuid())
  bookId           String
  voiceId          String
  status           NarrationJobStatus       @default(PENDING)
  storageProvider  NarrationStorageProvider @default(S3)
  manifestObjectKey String?
  audioMimeType    String                   @default("audio/mpeg")
  totalDurationMs  Int?
  totalChapters    Int                      @default(0)
  active           Boolean                  @default(false)
  readyAt          DateTime?
  errorMessage     String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  voice    NarrationVoice   @relation(fields: [voiceId], references: [id], onDelete: Restrict)
  chapters NarrationChapter[]

  @@unique([bookId, voiceId])
  @@index([bookId, active, status])
}

model NarrationChapter {
  id            String               @id @default(cuid())
  narrationId   String
  chapterIndex  Int
  title         String?
  spineHref     String
  status        NarrationAssetStatus @default(PENDING)
  audioObjectKey String?
  audioMimeType String               @default("audio/mpeg")
  durationMs    Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  narration BookNarration @relation(fields: [narrationId], references: [id], onDelete: Cascade)
  cues      NarrationCue[]

  @@unique([narrationId, chapterIndex])
  @@unique([narrationId, spineHref])
  @@index([narrationId, status])
}

model NarrationCue {
  id              String   @id @default(cuid())
  chapterId       String
  sequence        Int
  startMs         Int
  endMs           Int
  targetHref      String
  targetElementId String?
  targetCfi       String?
  excerpt         String?  @db.Text
  createdAt       DateTime @default(now())

  chapter NarrationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, sequence])
  @@index([chapterId, startMs])
}

enum PrintFormat {
  PAPERBACK
  HARDCOVER
}

enum NarrationJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum NarrationAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum NarrationStorageProvider {
  S3
  R2
  B2
  LOCAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DonationGateway {
  PAYPAL
  PAYSTACK
}

model SiteSettings {
  id          String   @id @default(cuid())
  socialLinks Json? // { twitter: "url", facebook: "url", etc. }
  updatedAt   DateTime @updatedAt
}

model SupplementaryContent {
  id        String      @id @default(cuid())
  bookId    String
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type      ContentType
  title     String
  content   String?     @db.Text // For POEM, QUOTE, ARTICLE (text body)
  url       String? // For VIDEO, ARTICLE (external link)
  author    String? // For QUOTE or POEM attribution
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum ContentType {
  VIDEO
  ARTICLE
  POEM
  QUOTE
}
