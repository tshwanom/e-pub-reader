generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  emailVerified     DateTime?
  name              String?
  password          String?
  role              UserRole          @default(READER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  audiobookId       String?
  readerPreferences Json?
  accounts          Account[]
  bookmarks         Bookmark[]
  donations         Donation[]
  highlights        Highlight[]
  notes             Note[]
  contentComments   ContentComment[]
  readingProgress   ReadingProgress[]
  sessions          Session[]
  audiobook         Audiobook?        @relation(fields: [audiobookId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id                    String                 @id @default(cuid())
  title                 String
  author                String
  description           String
  coverUrl              String
  slug                  String                 @unique
  status                BookStatus             @default(DRAFT)
  donorOnly             Boolean                @default(false)
  donorAccessLevel      BookDonorAccessLevel   @default(PUBLIC)
  publishedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  donationEnabled       Boolean                @default(false)
  donationMessage       String?
  donationGoal          Decimal?               @db.Decimal(10, 2)
  amazonKdpUrl          String?
  publisher             String?
  language              String?                @default("en")
  translationGroupId    String?
  isbn                  String?
  coverIsbn             String?
  subjects              String[]
  narrationEnabled      Boolean                @default(false)
  audioFiles            AudioFile[]
  audiobook             Audiobook?
  epubFile              BookFile?
  narrations            BookNarration[]
  bookmarks             Bookmark[]
  donations             Donation[]
  highlights            Highlight[]
  notes                 Note[]
  printLinks            PrintLink[]
  readingProgress       ReadingProgress[]
  supplementaryContents SupplementaryContent[]
  categories            Category[]             @relation("BookToCategory")

  @@index([translationGroupId])
}

model BookFile {
  id        String   @id @default(cuid())
  bookId    String   @unique
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model AudioFile {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  fileUrl   String
  duration  Int?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model PrintLink {
  id        String      @id @default(cuid())
  bookId    String
  provider  String
  format    PrintFormat
  url       String
  createdAt DateTime    @default(now())
  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  books Book[] @relation("BookToCategory")
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  cfi       String
  progress  Float
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  cfi       String
  chapter   String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  cfi       String
  text      String
  color     String   @default("#FFEB3B")
  note      String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  cfi       String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Donation {
  id                String          @id @default(cuid())
  userId            String?
  bookId            String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("USD")
  paypalId          String?         @unique
  status            DonationStatus
  createdAt         DateTime        @default(now())
  donorAmount       Decimal?        @db.Decimal(10, 2)
  donorCurrency     String?
  donorEmail        String?
  gateway           DonationGateway @default(PAYPAL)
  gatewayAmount     Decimal?        @db.Decimal(10, 2)
  gatewayCurrency   String?
  paystackReference String?         @unique
  paystackSubscriptionCode String?
  paystackPlanCode          String?
  paystackCustomerCode      String?
  frequency         DonationFrequency @default(ONE_TIME)
  book              Book?           @relation(fields: [bookId], references: [id])
  user              User?           @relation(fields: [userId], references: [id])
}

model Audiobook {
  id        String   @id @default(cuid())
  bookId    String   @unique
  fileUrl   String
  duration  Int
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  users     User[]
}

model NarrationVoice {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  provider          String
  language          String             @default("en")
  description       String?
  sampleText        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  narrations        BookNarration[]
  contentNarrations ContentNarration[]
}

model BookNarration {
  id                String                   @id @default(cuid())
  bookId            String
  voiceId           String
  status            NarrationJobStatus       @default(PENDING)
  storageProvider   NarrationStorageProvider @default(S3)
  manifestObjectKey String?
  audioMimeType     String                   @default("audio/mpeg")
  totalDurationMs   Int?
  totalChapters     Int                      @default(0)
  active            Boolean                  @default(false)
  readyAt           DateTime?
  errorMessage      String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  jobKey            String?
  stylePrompt       String?
  book              Book                     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  voice             NarrationVoice           @relation(fields: [voiceId], references: [id])
  chapters          NarrationChapter[]

  @@unique([bookId, voiceId])
  @@index([bookId, active, status])
}

model NarrationChapter {
  id             String               @id @default(cuid())
  narrationId    String
  chapterIndex   Int
  title          String?
  spineHref      String
  status         NarrationAssetStatus @default(PENDING)
  audioObjectKey String?
  audioMimeType  String               @default("audio/mpeg")
  durationMs     Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  narration      BookNarration        @relation(fields: [narrationId], references: [id], onDelete: Cascade)
  cues           NarrationCue[]

  @@unique([narrationId, chapterIndex])
  @@unique([narrationId, spineHref])
  @@index([narrationId, status])
}

model NarrationCue {
  id              String           @id @default(cuid())
  chapterId       String
  sequence        Int
  startMs         Int
  endMs           Int
  targetHref      String
  targetElementId String?
  targetCfi       String?
  excerpt         String?
  createdAt       DateTime         @default(now())
  chapter         NarrationChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, sequence])
  @@index([chapterId, startMs])
}

model SiteSettings {
  id              String   @id @default(cuid())
  socialLinks     Json?
  storageProvider String   @default("local")
  storageSettings String?
  updatedAt       DateTime @updatedAt
}

model SupplementaryContent {
  id                  String             @id @default(cuid())
  bookId              String?
  type                ContentType
  title               String
  content             String?
  url                 String?
  author              String?
  order               Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  coverUrl            String?
  donorOnly           Boolean            @default(false)
  donorAccessLevel    BookDonorAccessLevel @default(PUBLIC)
  narrationEnabled    Boolean            @default(false)
  publishedAt         DateTime?
  slug                String?            @unique
  status              ContentStatus      @default(DRAFT)
  summary             String?
  narrationSourceHash String?
  language            String?            @default("en")
  translationGroupId  String?
  comments            ContentComment[]
  narrations          ContentNarration[]
  book                Book?              @relation(fields: [bookId], references: [id])

  @@index([translationGroupId])
}

model ContentComment {
  id        String               @id @default(cuid())
  contentId String
  userId    String
  body      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  content   SupplementaryContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([userId, createdAt])
}

model ContentNarration {
  id              String                   @id @default(cuid())
  contentId       String
  voiceId         String
  status          NarrationJobStatus       @default(PENDING)
  storageProvider NarrationStorageProvider @default(S3)
  audioObjectKey  String?
  audioMimeType   String                   @default("audio/wav")
  durationMs      Int?
  active          Boolean                  @default(false)
  readyAt         DateTime?
  errorMessage    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  sourceHash      String?
  stylePrompt     String?
  content         SupplementaryContent     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  voice           NarrationVoice           @relation(fields: [voiceId], references: [id])

  @@unique([contentId, voiceId])
  @@index([contentId, active, status])
}

enum UserRole {
  READER
  EDITOR
  ADMIN
}

enum BookStatus {
  DRAFT
  COMING_SOON
  PRE_RELEASE
  PUBLISHED
  ARCHIVED
}

enum BookDonorAccessLevel {
  PUBLIC
  ALL_DONORS
  RECURRING_DONORS
}

enum PrintFormat {
  PAPERBACK
  HARDCOVER
}

enum NarrationJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum NarrationAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum NarrationStorageProvider {
  S3
  R2
  B2
  LOCAL
  HYBRID
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DonationGateway {
  PAYPAL
  PAYSTACK
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum ContentType {
  VIDEO
  ARTICLE
  POEM
  QUOTE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
