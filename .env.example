# Database
DATABASE_URL="postgresql://user:password@localhost:5432/epub_reader?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Resend (used for passwordless magic-link + code sign-in)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="One Man Revolution <auth@example.com>"

# UploadThing (get these from https://uploadthing.com/dashboard)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# Gemini TTS
GEMINI_API_KEY=""
GOOGLE_API_KEY="" # optional alternative to GEMINI_API_KEY
GEMINI_TTS_MODEL="gemini-3.1-flash-tts-preview"
GEMINI_TTS_DEFAULT_VOICE="Kore"

# Narration object storage (local disk is the safest single-server default)
# Preferred provider-agnostic variables
NARRATION_STORAGE_PROVIDER="local" # local | s3 | r2 | b2
NARRATION_STORAGE_REGION="" # required only for cloud providers
NARRATION_STORAGE_ENDPOINT="" # required only for cloud providers when applicable
NARRATION_STORAGE_ACCESS_KEY_ID="" # required only for cloud providers
NARRATION_STORAGE_SECRET_ACCESS_KEY="" # required only for cloud providers
NARRATION_STORAGE_BUCKET_NAME="" # required only for cloud providers
NARRATION_STORAGE_FORCE_PATH_STYLE="false"
NARRATION_STORAGE_PREFIX="narration"
NARRATION_STORAGE_SIGNED_URL_TTL_SECONDS="900"
NARRATION_STORAGE_LOCAL_DIR="storage" # used when NARRATION_STORAGE_PROVIDER="local"; keep persistent on Plesk

# AWS S3 compatibility variables (ignored when NARRATION_STORAGE_PROVIDER="local")
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_NARRATION_PREFIX="narration"
S3_SIGNED_URL_TTL_SECONDS="900"

# Cloudflare R2 convenience variables (ignored when NARRATION_STORAGE_PROVIDER="local")
R2_ACCOUNT_ID=""
R2_REGION="auto"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_FORCE_PATH_STYLE="false"

# Backblaze B2 convenience variables (ignored when NARRATION_STORAGE_PROVIDER="local")
B2_REGION=""
B2_ENDPOINT=""
B2_ACCESS_KEY_ID=""
B2_KEY_ID=""
B2_SECRET_ACCESS_KEY=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_FORCE_PATH_STYLE="false"

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # or "live" for production
PAYPAL_DONATION_PRODUCT_ID="" # optional; if empty, the app creates a donor-support product automatically
PAYPAL_WEBHOOK_ID="" # required for verifying /api/donations/paypal/webhook deliveries

# Paystack (ZAR checkout)
PAYSTACK_SECRET_KEY=""
# Configure your Paystack dashboard webhook URL to point at /api/donations/paystack/webhook for recurring lifecycle sync.

# CurrencyBeacon (used to normalize donations to USD and convert Paystack checkouts to ZAR)
CURRENCYBEACON_API_KEY=""


