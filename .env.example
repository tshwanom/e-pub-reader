# Database
DATABASE_URL="postgresql://user:password@localhost:5432/epub_reader?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# UploadThing (get these from https://uploadthing.com/dashboard)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # or "live" for production

# One-command Plesk deployment (optional)
PLESK_SSH_HOST="your.server.com"
PLESK_SSH_USER="your-ssh-user"
PLESK_SSH_PORT="22"
PLESK_REMOTE_PATH="/var/www/vhosts/yourdomain.com/httpdocs"
PLESK_SSH_KEY="" # Optional, e.g. C:/Users/you/.ssh/id_rsa
PLESK_REMOTE_ZIP_NAME="plesk-deploy.zip"
PLESK_INSTALL_COMMAND="npm ci --no-audit --no-fund"
PLESK_RUN_PRISMA_GENERATE="true"
PLESK_RUN_MIGRATIONS="true"
PLESK_RESTART_COMMAND="mkdir -p tmp && touch tmp/restart.txt"
PLESK_SKIP_BUILD="false"
